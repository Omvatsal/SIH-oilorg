# PostgreSQL connection (Supabase direct connection or pooler)
DATABASE_URL=

# Optional Supabase API access. Keep service role keys on the backend only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vector configuration must match the database VECTOR dimension in the migration.
# Defaults match the initial migration's VECTOR(384) columns.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=all-MiniLM-L6-v2-v1

# Application/auth configuration
APP_ENV=development
JWT_SECRET=
